#include <windows.h>
#include "setup.h"

#ifndef DS_3DLOOK
#define DS_3DLOOK 0x0004L
#endif

#ifdef WITH_W64
IDF_EXE35   NTRDPSFILE  "setup\\w64\\ntrdps.exe"
IDF_HOOK35  NTRDPSFILE  "setup\\w64\\ntrdpshk.dll"
IDF_MRSYS   NTRDPSFILE  "setup\\w64\\ntrdpsmr.sys"
IDF_MRDLL5  NTRDPSFILE  "setup\\w64\\ntrdpsm5.dll"
#else
#ifndef NO_NT31
IDF_EXE31   NTRDPSFILE  "setup\\nt31\\ntrdps.exe"
IDF_HOOK31  NTRDPSFILE  "setup\\nt31\\ntrdpshk.dll"
IDF_LAYER31 NTRDPSFILE  "setup\\nt31\\ntrdpsly.dll"
#endif
IDF_EXE35   NTRDPSFILE  "setup\\nt35\\ntrdps.exe"
IDF_HOOK35  NTRDPSFILE  "setup\\nt35\\ntrdpshk.dll"
#ifndef NO_LAYER35
IDF_LAYER35 NTRDPSFILE  "setup\\nt35\\ntrdpsly.dll"
#endif
#ifndef NO_NT40
IDF_MRSYS   NTRDPSFILE  "setup\\nt40\\ntrdpsmr.sys"
IDF_MRDLL   NTRDPSFILE  "setup\\nt40\\ntrdpsmr.dll"
IDF_MRDLL0  NTRDPSFILE  "setup\\nt40\\ntrdpsm0.dll"
#endif
#ifdef WITH_NT50
IDF_MRDLL5  NTRDPSFILE  "setup\\nt50\\ntrdpsm5.dll"
#endif
#endif

#ifdef NTRDPS_LOGIN
IDD_SETUP DIALOG 0, 0, 268, 152
STYLE DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ntrdps 安装"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "为 WinSta0 安装 RDP（远程桌面）服务器。",
                    -1, 8, 6, 252, 10
    AUTOCHECKBOX    "要求身份验证(&A)", IDC_CB_LOGIN, 8, 20, 252, 10,
                    WS_TABSTOP
    GROUPBOX        "性能", -1, 4, 36, 260, 38
    AUTORADIOBUTTON "&镜像驱动（快速，需要内核驱动）",
                    IDC_RB_DRIVER, 10, 47, 248, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&GDI 轮询（慢，无需驱动）",
                    IDC_RB_POLL, 10, 59, 248, 10
    GROUPBOX        "当前", -1, 4, 78, 260, 48
    LTEXT           "", IDC_STATUS, 10, 89, 248, 34
    DEFPUSHBUTTON   "&安装", IDC_INSTALL, 51, 132, 50, 14
    PUSHBUTTON      "&移除", IDC_REMOVE, 109, 132, 50, 14
    PUSHBUTTON      "关闭", IDCANCEL, 167, 132, 50, 14
END
#else
IDD_SETUP DIALOG 0, 0, 268, 258
STYLE DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ntrdps 安装"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "ntrdps 允许 RDP 客户端（远程桌面）使用此计算机的控制台。",
                    -1, 8, 6, 252, 10
    LTEXT           "无加密且无登录：任何能访问 TCP 端口 3389 的人都会获得控制台。请仅在可信网络中使用。",
                    -1, 8, 18, 252, 18
    GROUPBOX        "ntrdps 如何监视屏幕", -1, 4, 40, 260, 88
    AUTORADIOBUTTON "&快速 - 显示驱动   （推荐）",
                    IDC_RB_DRIVER, 10, 51, 248, 10, WS_GROUP | WS_TABSTOP
    LTEXT           "优点：网络字节数约减少十分之九，CPU 占用更低，拖动窗口时会显示移动画面。代价：需要重启一次。罕见风险：显示驱动故障可能导致启动时桌面停止（修复：启动“最后一次正确配置”）。",
                    -1, 20, 62, 240, 32
    AUTORADIOBUTTON "&安全 - 读取屏幕（无需驱动）",
                    IDC_RB_POLL, 10, 98, 248, 10
    LTEXT           "优点：无需驱动、无需重启，适用于所有机器。代价：速度较慢，网络和 CPU 开销更大，拖动窗口时没有移动画面。",
                    -1, 20, 109, 240, 18
    GROUPBOX        "安装将执行", -1, 4, 132, 260, 64
    LTEXT           "", IDC_PLAN, 10, 143, 248, 50
    GROUPBOX        "当前", -1, 4, 200, 260, 32
    LTEXT           "", IDC_STATUS, 10, 210, 248, 18
    DEFPUSHBUTTON   "&安装", IDC_INSTALL, 51, 238, 50, 14
    PUSHBUTTON      "&移除", IDC_REMOVE, 109, 238, 50, 14
    PUSHBUTTON      "关闭", IDCANCEL, 167, 238, 50, 14
END
#endif

#ifdef NTRDPS_LOGIN
IDD_ACCOUNT DIALOG 0, 0, 220, 120
STYLE DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ntrdps 账户"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "", IDC_ACC_TEXT, 8, 6, 204, 34
    LTEXT           "用户名(&U):", -1, 8, 47, 62, 8
    EDITTEXT        IDC_LUSER, 72, 45, 140, 12, ES_AUTOHSCROLL
    LTEXT           "密码(&P):", -1, 8, 63, 62, 8
    EDITTEXT        IDC_LPW, 72, 61, 140, 12, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "再次输入密码(&A):", -1, 8, 79, 62, 8
    EDITTEXT        IDC_LPW2, 72, 77, 140, 12, ES_PASSWORD | ES_AUTOHSCROLL
    DEFPUSHBUTTON   "确定", IDOK, 52, 100, 50, 14
    PUSHBUTTON      "取消", IDCANCEL, 118, 100, 50, 14
END
#endif
